# Copy to .env and fill in. Never commit the real .env file.

# --- Security ---------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ENVIRONMENT=development
COOKIE_SECURE=false            # set true when served over HTTPS

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset for zero-setup SQLite (backend/var/skillgap.db).
# PostgreSQL (primary target):
# DATABASE_URL=postgresql+psycopg://skillgap:YOUR_PASSWORD@localhost:5432/skillgap
POSTGRES_PASSWORD=change-me-db-password
AUTO_CREATE_TABLES=true        # false in production; use `alembic upgrade head`

# --- CORS / uploads / privacy -------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=5
STORE_UPLOADED_FILES=false     # privacy default: keep extracted text only
RETENTION_DAYS=180

# --- NLP models -----------------------------------------------------------------
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_SEMANTIC_MODEL=true
PRELOAD_MODELS=false
# Uncalibrated defaults - tune with backend/scripts/run_evaluation.py
SEMANTIC_STRONG_THRESHOLD=0.60
SEMANTIC_RELATED_THRESHOLD=0.45
TFIDF_STRONG_THRESHOLD=0.20
TFIDF_RELATED_THRESHOLD=0.10
MUST_HAVE_WEIGHT=2.0
NICE_TO_HAVE_WEIGHT=1.0
# GLOVE_PATH=/path/to/glove.kv
